# Konfigurasi fungsi. Nilai kosong sengaja menolak akses GPS sampai diverifikasi PM.
GEA_MUSEUM_LATITUDE=
GEA_MUSEUM_LONGITUDE=
GEA_MUSEUM_RADIUS_METERS=
GEA_MUSEUM_ZONE_ID=
# Origin browser yang diizinkan; native Expo tidak mengirim Origin.
GEA_ALLOWED_ORIGINS=http://localhost:8081
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY disuntikkan runtime Supabase.
# Untuk menjalankan Deno langsung, isi variabel tersebut hanya dalam file .env lokal.
